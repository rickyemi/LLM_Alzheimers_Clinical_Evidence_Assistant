# Copy to .env (never commit .env). All optional: the default runs fully offline.
AD_RAG_LLM_BACKEND=extractive          # extractive | anthropic
AD_RAG_EMBEDDING_BACKEND=hashing       # hashing | sentence-transformers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
API_KEY=                               # if set, clients must send X-API-Key
AD_RAG_ALLOW_NETWORK_TOOLS=false       # true lets the agent call live ClinicalTrials.gov
# LangSmith (optional, see notebook 07)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=ad-clinical-evidence-assistant
